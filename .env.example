# Copy this file to .env.local and replace the placeholders with your MongoDB Atlas connection details.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
EMAILJS_TO_EMAIL=you@example.com

# YouTube Data API (Videos tab)
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CHANNEL_HANDLE=@ilmoney_tech
# YOUTUBE_CHANNEL_ID=optional_channel_id
# YOUTUBE_UPLOADS_PLAYLIST_ID=optional_uploads_playlist_id
